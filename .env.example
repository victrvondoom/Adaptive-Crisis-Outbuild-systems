# AIDNEXUS ONE — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# OutSystems ODC
ODC_BASE_URL=https://your-tenant.outsystems.dev
ODC_API_KEY=your_api_key_here

# AWS Bedrock (for AI agents)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Azure AI (alternative provider)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Twilio (SMS notifications)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Optimizer Service
OPTIMIZER_HOST=0.0.0.0
OPTIMIZER_PORT=8080
OPTIMIZER_MAX_SOLVE_TIME_SECONDS=30

# Application
APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=true
